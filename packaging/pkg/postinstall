#!/bin/sh
# Runs as root after the pkg installs. Sets up the agent for whoever is logged in at the console.
user=$(stat -f %Su /dev/console)
if [ -z "$user" ] || [ "$user" = root ] || [ "$user" = loginwindow ]; then
    echo "steadywifi: nobody logged in; run 'steadywifi install' after logging in"
    exit 0
fi
/usr/local/bin/steadywifi install --user "$user" || exit 1
uid=$(id -u "$user")
launchctl asuser "$uid" sudo -u "$user" open /Applications/SteadyWiFi.app
exit 0
